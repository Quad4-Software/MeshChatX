FROM python:3.11-alpine@sha256:cd04730b8511def3fbf14204d66a0c1536f290b8e896ed5a94cd64cb15ac1356

WORKDIR /build

RUN apk add --no-cache \
    build-base \
    python3-dev \
    git \
    libffi-dev \
    openssl-dev

COPY docker/requirements-poetry.txt /tmp/requirements-poetry.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-poetry.txt

COPY pyproject.toml poetry.lock README.md LICENSE ./
COPY lxmfy ./lxmfy

RUN poetry config virtualenvs.create false && \
    poetry build

CMD ["cp", "-r", "dist/", "/output/"]
