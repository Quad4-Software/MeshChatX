[Desktop Entry]
Name=Reticulum MeshChatX
Comment=A simple mesh network communications app powered by the Reticulum Network Stack
Exec=meshchatx-desktop
Icon=com.meshchatx.app
Terminal=false
Type=Application
Categories=Network;InstantMessaging;Chat;
MimeType=x-scheme-handler/lxmf;x-scheme-handler/rns;
StartupWMClass=com.meshchatx.app
