{
  "app-id": "com.meshchatx.app",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "bin/meshchatx-desktop",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--device=all",
    "--allow=bluetooth",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.login1",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.Flatpak",
    "--filesystem=xdg-download/MeshChatX:create",
    "--env=TMPDIR=/var/tmp",
    "--env=XDG_DATA_HOME=/var/data",
    "--env=WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=0"
  ],
  "modules": [
    {
      "name": "meshchatx-app",
      "buildsystem": "simple",
      "builddir": true,
      "build-commands": [
        "set -e",
        "install -Dm755 payload/bin/meshchatx-desktop /app/bin/meshchatx-desktop",
        "mkdir -p /app/lib/reticulum-meshchatx",
        "cp -a payload/backend /app/lib/reticulum-meshchatx/backend",
        "install -Dm644 payload/share/com.meshchatx.app.desktop /app/share/applications/com.meshchatx.app.desktop",
        "install -Dm644 payload/share/com.meshchatx.app.metainfo.xml /app/share/metainfo/com.meshchatx.app.metainfo.xml",
        "install -Dm644 payload/share/com.meshchatx.app.png /app/share/icons/hicolor/512x512/apps/com.meshchatx.app.png"
      ],
      "sources": [
        {
          "type": "file",
          "path": "../../desktop/bin/meshchatx-desktop",
          "dest": "payload/bin"
        },
        {
          "type": "dir",
          "path": "../../build/exe/linux-x64",
          "dest": "payload/backend"
        },
        {
          "type": "file",
          "path": "com.meshchatx.app.desktop",
          "dest": "payload/share"
        },
        {
          "type": "file",
          "path": "com.meshchatx.app.metainfo.xml",
          "dest": "payload/share"
        },
        {
          "type": "file",
          "path": "com.meshchatx.app.png",
          "dest": "payload/share"
        }
      ]
    }
  ],
  "build-options": {
    "append-path": "/usr/bin",
    "env": {}
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/pkgconfig",
    "*.a"
  ],
  "rename-desktop-file": "com.meshchatx.app.desktop",
  "rename-icon": "com.meshchatx.app",
  "desktop-file-name-suffix": "",
  "finish-args-extra": [],
  "add-extensions": {},
  "cleanup-commands": [],
  "run-commands": [],
  "sdk-extensions": [],
  "separate-locales": false,
  "remove-static-libraries": true,
  "remove-docs": true,
  "remove-patents": true,
  "remove-licenses": false,
  "patches": [],
  "post-install": [],
  "sources": []
}