{
  "app-id": "com.meshchatx.app",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "bin/meshchatx-desktop",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--device=all",
    "--allow=bluetooth",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.login1",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.Flatpak",
    "--filesystem=xdg-download/MeshChatX:create",
    "--env=TMPDIR=/var/tmp",
    "--env=XDG_DATA_HOME=/var/data",
    "--env=WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=0"
  ],
  "modules": [],
  "build-options": { "append-path": "/usr/bin", "env": {} },
  "cleanup": ["/include", "/lib/pkgconfig", "/share/pkgconfig", "*.a"],
  "rename-desktop-file": "com.meshchatx.app.desktop",
  "rename-icon": "com.meshchatx.app",
  "desktop-file-name-suffix": "",
  "finish-args-extra": [],
  "add-extensions": {},
  "cleanup-commands": [],
  "run-commands": [],
  "sdk-extensions": [],
  "separate-locales": false,
  "remove-static-libraries": true,
  "remove-docs": true,
  "remove-patents": true,
  "remove-licenses": false,
  "patches": [],
  "post-install": [],
  "sources": [
    {
      "type": "file",
      "path": "desktop/bin/meshchatx-desktop",
      "dest": "bin/meshchatx-desktop"
    },
    {
      "type": "dir",
      "path": "build/exe/linux-x64",
      "dest": "lib/reticulum-meshchatx/backend"
    },
    {
      "type": "file",
      "path": "packaging/flatpak/com.meshchatx.app.desktop",
      "dest": "share/applications/com.meshchatx.app.desktop"
    },
    {
      "type": "file",
      "path": "packaging/flatpak/com.meshchatx.app.metainfo.xml",
      "dest": "share/metainfo/com.meshchatx.app.metainfo.xml"
    },
    {
      "type": "file",
      "path": "packaging/flatpak/com.meshchatx.app.png",
      "dest": "share/icons/hicolor/512x512/apps/com.meshchatx.app.png"
    }
  ]
}
