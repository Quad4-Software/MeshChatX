# Maintainer: Ivan <ivan@quad4.io>
pkgname=reticulum-meshchatx-git
_pkgname=reticulum-meshchatx
pkgver=4.12.0.r0.gc3610365
pkgrel=1
pkgdesc="A simple mesh network communications app powered by the Reticulum Network Stack"
arch=('x86_64' 'aarch64')
url="https://github.com/Quad4-Software/MeshChatX"
license=('0BSD' 'MIT')
depends=('opus' 'opusfile' 'portaudio' 'espeak-ng' 'gtk4' 'webkitgtk-6.0' 'libsoup3' 'gst-plugins-base' 'gst-plugins-good')
makedepends=('git' 'go' 'nodejs' 'pnpm' 'python' 'python-pip' 'python-setuptools' 'python-wheel')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+https://github.com/Quad4-Software/MeshChatX.git"
        "reticulum-meshchatx.desktop")
sha256sums=('SKIP'
            'e0b1ad738415c2b6fbf5d042b240b8dc61d527ecbe2943f6c54b3eb902db2ac3')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || \
  printf "4.12.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export PNPM_HOME="$srcdir/.pnpm-home"
  local _venv="$srcdir/$_pkgname/.build-venv"

  pnpm install --frozen-lockfile

  python -m venv "$_venv"
  # shellcheck disable=SC1091
  source "$_venv/bin/activate"
  pip install --upgrade pip setuptools wheel "uv==0.11.15"
  uv lock --check
  uv sync --group dev --active
  python scripts/patch_lxst_pyogg_ogg_ctypes.py
  python scripts/patch_lxst_codec2_optional.py
}

build() {
  cd "$_pkgname"
  export PNPM_HOME="$srcdir/.pnpm-home"
  export PYTHON_CMD="$srcdir/$_pkgname/.build-venv/bin/python"

  pnpm run build-frontend
  pnpm run build-docs
  pnpm run build-repository-wheels
  export PLATFORM=linux pnpm run build-backend

  # Go >= 1.27 + Wails v3 desktop shell
  export PATH="$PATH:$(go env GOPATH)/bin"
  (cd desktop && wails3 generate icons -input build/appicon.png -outputdir build >/dev/null 2>&1 || true)
  (cd desktop && CGO_ENABLED=1 go build -tags production -trimpath -buildvcs=false -ldflags="-w -s" -o bin/reticulum-meshchatx .)
  mkdir -p desktop/bin/backend
  cp -a "build/exe/linux-x64/." desktop/bin/backend/
}

package() {
  cd "$_pkgname"

  install -d "$pkgdir/usr/lib/$_pkgname/backend"
  install -m755 "$srcdir/$_pkgname/desktop/bin/reticulum-meshchatx" "$pkgdir/usr/lib/$_pkgname/reticulum-meshchatx"
  cp -a "$srcdir/$_pkgname/desktop/bin/backend/." "$pkgdir/usr/lib/$_pkgname/backend/"

  install -d "$pkgdir/usr/bin"
  ln -s "/usr/lib/$_pkgname/reticulum-meshchatx" "$pkgdir/usr/bin/$_pkgname"

  install -Dm644 "$srcdir/reticulum-meshchatx.desktop" "$pkgdir/usr/share/applications/reticulum-meshchatx.desktop"
  install -Dm644 logo/logo.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/reticulum-meshchatx.png"
}
