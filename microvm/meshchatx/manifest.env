DESCRIPTION="MeshChatX all-in-one Reticulum client (LXMF messaging, calls, NomadNet, map)"
MEM_MIB=1024
VCPU_COUNT=1
DATA_SIZE_MIB=2048
ROOTFS_SIZE_MIB=1536
PORT_FORWARDS=8000:8000
PACKAGES="ca-certificates python3 py3-pip py3-virtualenv"
TAGS=network,reticulum,messaging
DATA_HINT=/data/meshchatx
HARDEN=on
