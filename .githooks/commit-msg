#!/bin/sh
# commit-msg: validate commit message with commitlint.
#
# Enable with: task hooks:install
# Skip: SKIP=commitlint git commit ...  or  SKIP_COMMITLINT=1
# SPDX-License-Identifier: 0BSD
set -eu

if [ "${SKIP_COMMITLINT:-0}" = "1" ]; then
	exit 0
fi

ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if ! command -v uv >/dev/null 2>&1; then
	echo "commit-msg: uv not found. Run: task install" >&2
	exit 1
fi

exec uv run pre-commit run --hook-stage commit-msg --commit-msg-filename "$1"
