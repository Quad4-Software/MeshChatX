#!/bin/sh
# pre-commit: format and lint staged files, resign meshchatx.rsm when needed.
#
# Enable once per clone:
#   task hooks:install
#
# Skip one hook:
#   SKIP=ruff-format git commit ...
#
# Skip all hooks:
#   git commit --no-verify
#
# Skip RSM resign only:
#   SKIP=meshchatx-rsm git commit ...
# SPDX-License-Identifier: 0BSD
set -eu

if [ "${SKIP_PRE_COMMIT:-0}" = "1" ]; then
	exit 0
fi

ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if ! command -v uv >/dev/null 2>&1; then
	echo "pre-commit: uv not found. Run: task install" >&2
	exit 1
fi

exec uv run pre-commit run --hook-stage pre-commit
