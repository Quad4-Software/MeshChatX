# Argus findings suppressions.
# Format: RULE (everywhere) | RULE path/glob | * path (everything under path)

# Dependency and build trees: scanned upstream, not first-party code.
* .venv/**
* node_modules/**
* vendor/**
* .local/**
* temp-tests/**
* dist/**
* build/**

# Local TLS material generated for dev storage.
* storage/ssl/**

# First-party install/packaging code that legitimately does what the rules flag.
CNT-001 docker/Dockerfile.build
CNT-001 docker/Dockerfile.dev
# Dockerfile.ci: .env* is excluded through scripts/ci/ci.dockerignore, which
# run-docker.sh passes via --ignorefile. Argus cannot resolve the custom
# ignorefile name, so CNT-009 fires on the wildcard COPY anyway.
CNT-009 scripts/ci/Dockerfile.ci
AUR-002 packaging/arch/PKGBUILD
MAL-030 scripts/rpi/install_meshchatx.sh
MAL-030 proxmox/build-lxc.sh
MAL-030 proxmox/build-vm-template.sh
MAL-061 tests/backend/test_http_helpers.py

# Argus ruleset drift (the pinned action installs the latest argus binary at
# run time, so new rules land without a workflow change). Suppressions below
# are verified false positives; revisit when the scanner is fixed.

# QIX-016/QIX-018 misattribute package versions inside pnpm-lock snapshot
# blocks: the 256-byte version window after a name match picks up an
# unrelated entry (cliui@9.0.1, color-convert@2.0.1). Resolved versions are
# wrap-ansi 6.2.0/7.0.0/9.0.2 and color-name 1.1.4; the phished versions
# 9.0.1 and 2.0.1 are not in the lockfile.
QIX-016 pnpm-lock.yaml
QIX-018 pnpm-lock.yaml

# JS-003 fires on spawnSync/execSync in build and test tooling. All call
# sites pass argument arrays with shell disabled.
JS-003 scripts/build-backend.js
JS-003 scripts/build-electron-shell-css.mjs
JS-003 scripts/build-geo-wasm.mjs
JS-003 scripts/build-visualiser-wasm.mjs
JS-003 scripts/fetch-starter-mbtiles.mjs
JS-003 scripts/mutation/run.mjs
JS-003 scripts/ui/metrics-check.mjs
JS-003 tests/e2e/mobile-crawl.spec.js
JS-003 tests/frontend/bakeBuildMeta.test.js

# OWASP-001: the alg:none JWT in this test is a rejection fixture asserting
# the verifier refuses unsigned tokens.
OWASP-001 tests/backend/test_oidc.py

# AST exec-family indicators (landed in a newer ruleset): every flagged site
# is deliberate and reviewed - module/plugin loaders, test harnesses, and CI
# tooling. They carry noqa or harness-level guards already.
AST-PY-002 meshchatx/src/backend/recovery/crash_recovery.py
AST-PY-002 meshchatx/src/backend/voicemail_manager.py
AST-PY-005 meshchatx/src/backend/lxst_pyogg_ctypes_compat.py
AST-PY-005 meshchatx/src/backend/sideband_plugin_loader.py
AST-PY-005 tests/backend/test_crash_recovery.py
AST-GO-001 geo-wasm/mgrs/geolib_test.go
AST-GO-001 geo-wasm/mgrs/proj_test.go
AST-GO-001 geo-wasm/mgrs/ups_proj_test.go
AST-GO-001 scripts/license_scope_mapper.go

# Wails desktop shell (desktop/): reviewed intentional process/TLS use.
# GO-001 sites are loopback-only (annotated in source); exec.Command sites
# spawn the backend binary, platform helpers (explorer/open/pmset/taskkill),
# or test fixtures - all argument-array form, no shell interpolation.
GO-001 desktop/internal/appserver/appserver.go
GO-001 desktop/internal/bridge/bridge.go
AST-GO-001 desktop/internal/backendproc/backendproc.go
AST-GO-001 desktop/internal/backendproc/backendproc_test.go
AST-GO-001 desktop/internal/backendproc/kill_orphan_windows.go
AST-GO-001 desktop/internal/backendproc/kill_windows.go
AST-GO-001 desktop/internal/serial/serial_test.go
AST-GO-001 desktop/internal/system/power_darwin.go
AST-GO-001 desktop/internal/system/powerstate_darwin.go
AST-GO-001 desktop/main.go
GO-002 desktop/internal/backendproc/backendproc_test.go
JS-003 scripts/build-desktop-shell-css.mjs
